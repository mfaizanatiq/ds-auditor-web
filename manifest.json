{
  "manifest_version": 3,
  "name": "DS Auditor for Web",
  "version": "0.2.1",
  "description": "Design system linter for live web pages. Audit typography, spacing, colors, shadows, and more against your token libraries.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "DS Auditor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html",
        "popup/popup.css",
        "popup/popup.js",
        "lib/html-report.js",
        "content/panel-shell.css",
        "lib/*",
        "data/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
